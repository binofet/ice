{
  "version": 2,
  "configurePresets": [
    {
      "name": "desktop-debug",
      "displayName": "Desktop Debug (C++23)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "ICE_WARNINGS_AS_ERRORS": "ON",
        "ICE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "desktop-release",
      "inherits": "desktop-debug",
      "binaryDir": "${sourceDir}/build/desktop-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "desktop-sanitize",
      "inherits": "desktop-debug",
      "binaryDir": "${sourceDir}/build/desktop-sanitize",
      "cacheVariables": {
        "ICE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "desktop-cxx20",
      "inherits": "desktop-debug",
      "displayName": "Desktop Debug (C++20)",
      "binaryDir": "${sourceDir}/build/desktop-cxx20",
      "cacheVariables": {
        "ICE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "headless-debug",
      "inherits": "desktop-debug",
      "binaryDir": "${sourceDir}/build/headless-debug",
      "cacheVariables": {
        "ICE_BUILD_DESKTOP": "OFF",
        "ICE_BUILD_METAL": "OFF",
        "ICE_BUILD_OPENGL": "OFF",
        "ICE_BUILD_COMPANION": "OFF",
        "ICE_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "headless-tiny",
      "inherits": "headless-debug",
      "displayName": "Minimal headless core (no physics or scripting downloads)",
      "binaryDir": "${sourceDir}/build/headless-tiny",
      "cacheVariables": {
        "ICE_BUILD_PHYSICS_2D": "OFF",
        "ICE_BUILD_PHYSICS_3D": "OFF",
        "ICE_BUILD_SCRIPTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release"
    },
    {
      "name": "desktop-sanitize",
      "configurePreset": "desktop-sanitize"
    },
    {
      "name": "desktop-cxx20",
      "configurePreset": "desktop-cxx20"
    },
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug"
    },
    {
      "name": "headless-tiny",
      "configurePreset": "headless-tiny"
    }
  ],
  "testPresets": [
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-sanitize",
      "configurePreset": "desktop-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-cxx20",
      "configurePreset": "desktop-cxx20",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-tiny",
      "configurePreset": "headless-tiny",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
