include_guard(GLOBAL)
include(FetchContent)

# Source-only dependencies. An enabled module downloads its immutable, hash-checked
# upstream archive on first configure. Explicit source overrides also support offline
# builds and deliberate local backend work; they bypass archive verification.
set(ICE_BOX2D_SOURCE_DIR "" CACHE PATH "Optional local Box2D 3.1.1 source tree (no download)")
set(ICE_JOLT_SOURCE_DIR "" CACHE PATH "Optional local Jolt 5.6.0 source tree (no download)")

function(ice_physics_vendor_sanitizers target)
    if(ICE_ENABLE_SANITIZERS)
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} INTERFACE -fsanitize=address,undefined)
    endif()
endfunction()

function(ice_require_box2d)
    if(TARGET box2d)
        return()
    endif()
    if(CMAKE_VERSION VERSION_LESS 3.22)
        message(FATAL_ERROR "Box2D 3.1.1 requires CMake 3.22; upgrade or disable ICE_BUILD_PHYSICS_2D")
    endif()
    set(BUILD_SHARED_LIBS OFF)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(BOX2D_SAMPLES OFF)
    set(BOX2D_UNIT_TESTS OFF)
    set(BOX2D_BENCHMARKS OFF)
    set(BOX2D_DOCS OFF)
    set(BOX2D_PROFILE OFF)
    set(BOX2D_VALIDATE OFF)
    set(BOX2D_AVX2 OFF)
    set(BOX2D_COMPILE_WARNING_AS_ERROR OFF)
    # Baseline x86 SSE2 / AArch64 NEON, rather than host-specific AVX tuning.
    set(BOX2D_DISABLE_SIMD OFF)
    if(ICE_BOX2D_SOURCE_DIR)
        get_filename_component(source "${ICE_BOX2D_SOURCE_DIR}" REALPATH)
        if(NOT EXISTS "${source}/include/box2d/box2d.h" OR NOT EXISTS "${source}/CMakeLists.txt")
            message(FATAL_ERROR "ICE_BOX2D_SOURCE_DIR must contain the Box2D 3.x source tree")
        endif()
        set(FETCHCONTENT_SOURCE_DIR_ICE_BOX2D "${source}")
        message(STATUS "ICE Box2D explicit source override: ${source}")
    endif()
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    FetchContent_Declare(ice_box2d
        URL https://codeload.github.com/erincatto/box2d/tar.gz/8c661469c9507d3ad6fbd2fea3f1aa71669c2fe3
        URL_HASH SHA256=dee7bcf0f50b3dcccf67678ce14ffe3ce02583b51b8b03e447ab30a84c3436ef)
    FetchContent_MakeAvailable(ice_box2d)
    ice_physics_vendor_sanitizers(box2d)
endfunction()

function(ice_require_jolt)
    if(TARGET Jolt)
        return()
    endif()
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(JPH_BUILD_SHARED_LIBS OFF)
    set(OVERRIDE_CXX_FLAGS OFF)
    set(INTERPROCEDURAL_OPTIMIZATION OFF)
    set(ENABLE_ALL_WARNINGS OFF)
    set(ENABLE_INSTALL OFF)
    # UBSan's vptr checks in the ICE wrapper need matching upstream typeinfo.
    # Keep those checks intact in instrumented builds; normal builds omit RTTI.
    set(CPP_RTTI_ENABLED ${ICE_ENABLE_SANITIZERS})
    set(CPP_EXCEPTIONS_ENABLED OFF)
    set(USE_STATIC_MSVC_RUNTIME_LIBRARY OFF)
    set(FLOATING_POINT_EXCEPTIONS_ENABLED OFF)
    set(DOUBLE_PRECISION OFF)
    set(CROSS_PLATFORM_DETERMINISTIC ON)
    set(DEBUG_RENDERER_IN_DEBUG_AND_RELEASE OFF)
    set(DEBUG_RENDERER_IN_DISTRIBUTION OFF)
    set(PROFILER_IN_DEBUG_AND_RELEASE OFF)
    set(PROFILER_IN_DISTRIBUTION OFF)
    set(ENABLE_OBJECT_STREAM OFF)
    foreach(feature SSE4_1 SSE4_2 AVX AVX2 AVX512 LZCNT TZCNT F16C FMADD)
        set(USE_${feature} OFF)
    endforeach()
    # Jolt 5.6 introduces GPU compute/hair. The rigid-body baseline needs no GPU
    # toolchain, compiler downloads, samples or external rendering dependencies.
    foreach(backend DX12 VK MTL CPU_COMPUTE)
        set(JPH_USE_${backend} OFF)
    endforeach()
    foreach(sample UNIT_TESTS HELLO_WORLD PERFORMANCE_TEST SAMPLES VIEWER)
        set(TARGET_${sample} OFF)
    endforeach()
    if(ICE_JOLT_SOURCE_DIR)
        get_filename_component(source "${ICE_JOLT_SOURCE_DIR}" REALPATH)
        if(NOT EXISTS "${source}/Jolt/Jolt.h" OR NOT EXISTS "${source}/Build/CMakeLists.txt")
            message(FATAL_ERROR "ICE_JOLT_SOURCE_DIR must contain the Jolt Physics source tree")
        endif()
        set(FETCHCONTENT_SOURCE_DIR_ICE_JOLT "${source}")
        message(STATUS "ICE Jolt explicit source override: ${source}")
    endif()
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    FetchContent_Declare(ice_jolt
        URL https://codeload.github.com/jrouwe/JoltPhysics/tar.gz/e77f175595e64cb44218cc9d9d56fc365ad0e36a
        URL_HASH SHA256=1f32328fb763135de10a244568d6ccb2ed9b1e6593fafe6dc6db5b2719d330bd
        SOURCE_SUBDIR Build)
    FetchContent_MakeAvailable(ice_jolt)
    ice_physics_vendor_sanitizers(Jolt)
endfunction()
