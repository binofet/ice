include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ICEExpected.cmake")
get_filename_component(ICE_DESKTOP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(ICEWindowRuntime STATIC "${ICE_DESKTOP_ROOT}/engine/src/platform/desktop_window.cpp")
add_library(ice::window ALIAS ICEWindowRuntime)
target_link_libraries(ICEWindowRuntime PUBLIC ice::expected ice::platform)
if(APPLE)
    enable_language(OBJCXX)
    target_sources(ICEWindowRuntime PRIVATE "${ICE_DESKTOP_ROOT}/engine/src/platform/macos/desktop_window.mm")
    target_compile_options(ICEWindowRuntime PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
    target_link_libraries(ICEWindowRuntime PRIVATE "-framework AppKit")
elseif(WIN32)
    target_sources(ICEWindowRuntime PRIVATE "${ICE_DESKTOP_ROOT}/engine/src/platform/win32/desktop_window.cpp")
    target_compile_definitions(ICEWindowRuntime PRIVATE _WIN32_WINNT=0x0A00 UNICODE _UNICODE NOMINMAX)
    target_link_libraries(ICEWindowRuntime PRIVATE user32 gdi32)
else()
    find_package(X11 REQUIRED)
    target_sources(ICEWindowRuntime PRIVATE "${ICE_DESKTOP_ROOT}/engine/src/platform/x11/desktop_window.cpp")
    target_link_libraries(ICEWindowRuntime PRIVATE X11::X11)
endif()
ice_strict_target(ICEWindowRuntime)
