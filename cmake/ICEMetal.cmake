include_guard(GLOBAL)
if(NOT APPLE OR CMAKE_SYSTEM_NAME STREQUAL "watchOS")
    message(FATAL_ERROR "ICE_BUILD_METAL requires a supported Apple Metal SDK")
endif()
enable_language(OBJCXX)
get_filename_component(ICE_METAL_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(ICEMetalRuntime STATIC "${ICE_METAL_ROOT}/engine/src/render/metal/device.mm")
add_library(ice::metal ALIAS ICEMetalRuntime)
target_include_directories(ICEMetalRuntime PUBLIC "${ICE_METAL_ROOT}/engine/include")
target_link_libraries(ICEMetalRuntime PUBLIC ice::expected ice::uri PRIVATE "-framework Metal" "-framework QuartzCore" "-framework Foundation")
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    target_link_libraries(ICEMetalRuntime PRIVATE "-framework AppKit")
endif()
target_compile_options(ICEMetalRuntime PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
set_target_properties(ICEMetalRuntime PROPERTIES POSITION_INDEPENDENT_CODE ON XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED NO)
ice_strict_target(ICEMetalRuntime)
