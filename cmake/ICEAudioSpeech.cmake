include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ICEAudioPCM.cmake")
# FindThreads probes the platform, not the C++23 library. Its nested try_compile
# does not inherit NDK r26's accepted c++2b spelling from ICEStandards.cmake.
if(ANDROID AND ICE_CXX_STANDARD STREQUAL "23" AND NOT ICE_ANDROID_CPP23_FINAL_SPELLING)
    set(CMAKE_CXX_STANDARD 20)
    find_package(Threads REQUIRED)
    set(CMAKE_CXX_STANDARD 23)
else()
    find_package(Threads REQUIRED)
endif()
get_filename_component(ICE_SPEECH_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(ICEAudioSpeech STATIC "${ICE_SPEECH_ROOT}/engine/src/audio/speech.cpp")
add_library(ice::audio_speech ALIAS ICEAudioSpeech)
target_include_directories(ICEAudioSpeech PUBLIC "${ICE_SPEECH_ROOT}/engine/include")
target_link_libraries(ICEAudioSpeech PUBLIC ice::audio_pcm)
target_link_libraries(ICEAudioSpeech PRIVATE Threads::Threads)
target_compile_features(ICEAudioSpeech PUBLIC cxx_std_${ICE_CXX_STANDARD})
set_target_properties(ICEAudioSpeech PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(APPLE)
    enable_language(OBJCXX)
    target_sources(ICEAudioSpeech PRIVATE "${ICE_SPEECH_ROOT}/engine/src/audio/apple_speech.mm")
    target_compile_options(ICEAudioSpeech PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
    target_compile_definitions(ICEAudioSpeech PUBLIC ICE_HAS_APPLE_SPEECH=1)
    target_link_libraries(ICEAudioSpeech PRIVATE "-framework Foundation" "-framework AVFAudio")
endif()
ice_strict_target(ICEAudioSpeech)
