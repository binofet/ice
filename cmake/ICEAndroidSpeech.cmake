include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ICEAudioSpeech.cmake")
get_filename_component(ICE_ANDROID_SPEECH_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(ICEAndroidSpeech STATIC "${ICE_ANDROID_SPEECH_ROOT}/engine/src/audio/android/stream.cpp")
add_library(ice::android_speech ALIAS ICEAndroidSpeech)
target_link_libraries(ICEAndroidSpeech PUBLIC ice::audio_speech)
target_compile_features(ICEAndroidSpeech PUBLIC cxx_std_${ICE_CXX_STANDARD})
target_include_directories(ICEAndroidSpeech PUBLIC "${ICE_ANDROID_SPEECH_ROOT}/engine/include")
set_target_properties(ICEAndroidSpeech PROPERTIES POSITION_INDEPENDENT_CODE ON
    ICE_JAVA_SOURCES "${ICE_ANDROID_SPEECH_ROOT}/engine/java/org/ice/audio/AndroidSpeechBridge.java")
if(ANDROID)
    target_sources(ICEAndroidSpeech PRIVATE "${ICE_ANDROID_SPEECH_ROOT}/engine/src/audio/android/android_speech.cpp")
endif()
ice_strict_target(ICEAndroidSpeech)
