include_guard(GLOBAL)

# Shared by the desktop project and the independently configured mobile project.
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_OBJCXX_STANDARD 20)
set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
set(CMAKE_OBJCXX_EXTENSIONS OFF)

option(ICE_WARNINGS_AS_ERRORS "Treat warnings as errors in adopted first-party targets" ON)
option(ICE_ENABLE_SANITIZERS "Instrument adopted targets with Address/UndefinedBehaviorSanitizer" OFF)

function(ice_strict_target target)
    if(MSVC)
        target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:/W4;/permissive-;/Zc:__cplusplus>")
        if(ICE_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:/WX>")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$")
        target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:-Wall;-Wextra;-Wpedantic>")
        if(ICE_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:-Werror>")
        endif()
    endif()
    if(ICE_ENABLE_SANITIZERS)
        if(MSVC OR NOT CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$")
            message(FATAL_ERROR "ICE_ENABLE_SANITIZERS requires a GCC/Clang driver")
        endif()
        target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:-fsanitize=address,undefined;-fno-omit-frame-pointer>")
        # Static-library link options must reach their executable consumers.
        get_target_property(kind ${target} TYPE)
        if(kind STREQUAL "STATIC_LIBRARY")
            target_link_options(${target} INTERFACE -fsanitize=address,undefined)
        else()
            target_link_options(${target} PRIVATE -fsanitize=address,undefined)
        endif()
    endif()
endfunction()
