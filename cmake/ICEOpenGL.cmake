include_guard(GLOBAL)
if(ANDROID OR CMAKE_SYSTEM_NAME MATCHES "^(iOS|watchOS|tvOS|visionOS)$")
    message(FATAL_ERROR "ICE_BUILD_OPENGL is a desktop core-profile backend; mobile Metal/Vulkan use separate hosts")
endif()
get_filename_component(ICE_GL_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(ICEOpenGLRuntime STATIC "${ICE_GL_ROOT}/engine/src/render/gl/device.cpp")
add_library(ice::opengl ALIAS ICEOpenGLRuntime)
target_include_directories(ICEOpenGLRuntime PUBLIC "${ICE_GL_ROOT}/engine/include")
target_include_directories(ICEOpenGLRuntime SYSTEM PRIVATE "${ICE_GL_ROOT}/engine/3rdparty/khronos")
target_link_libraries(ICEOpenGLRuntime PUBLIC ice::expected ice::uri)
if(APPLE)
    enable_language(OBJCXX)
    target_sources(ICEOpenGLRuntime PRIVATE "${ICE_GL_ROOT}/engine/src/render/gl/macos.mm")
    set_source_files_properties("${ICE_GL_ROOT}/engine/src/render/gl/macos.mm" PROPERTIES COMPILE_OPTIONS "-fobjc-arc;-Wno-deprecated-declarations")
    target_link_libraries(ICEOpenGLRuntime PRIVATE "-framework AppKit" "-framework OpenGL")
elseif(WIN32)
    target_sources(ICEOpenGLRuntime PRIVATE "${ICE_GL_ROOT}/engine/src/render/gl/win32.cpp")
    target_compile_definitions(ICEOpenGLRuntime PRIVATE _WIN32_WINNT=0x0A00 UNICODE _UNICODE NOMINMAX)
    target_link_libraries(ICEOpenGLRuntime PRIVATE opengl32 user32 gdi32)
else()
    find_package(OpenGL REQUIRED)
    find_package(X11 REQUIRED)
    target_sources(ICEOpenGLRuntime PRIVATE "${ICE_GL_ROOT}/engine/src/render/gl/x11.cpp")
    target_link_libraries(ICEOpenGLRuntime PRIVATE OpenGL::GL X11::X11)
endif()
set_target_properties(ICEOpenGLRuntime PROPERTIES POSITION_INDEPENDENT_CODE ON)
ice_strict_target(ICEOpenGLRuntime)
