include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ICEAudio.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ICEData.cmake")
get_filename_component(ICE_AUDIO_STORE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(ICEAudioStore STATIC "${ICE_AUDIO_STORE_ROOT}/engine/src/audio/recording_store.cpp")
add_library(ice::audio_store ALIAS ICEAudioStore)
target_include_directories(ICEAudioStore PUBLIC "${ICE_AUDIO_STORE_ROOT}/engine/include")
target_link_libraries(ICEAudioStore PUBLIC ice::audio PRIVATE ice::data)
if(WIN32)
    target_link_libraries(ICEAudioStore PRIVATE advapi32)
endif()
target_compile_features(ICEAudioStore PUBLIC cxx_std_${ICE_CXX_STANDARD})
set_target_properties(ICEAudioStore PROPERTIES POSITION_INDEPENDENT_CODE ON)
ice_strict_target(ICEAudioStore)
