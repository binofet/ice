include_guard(GLOBAL)
if(NOT WIN32 OR NOT ICE_BUILD_DESKTOP)
    message(FATAL_ERROR "ICE first Vulkan slice requires Win32 desktop windows")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ICEShaderSource.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ICEDesktop.cmake")
find_package(Vulkan 1.3.261 REQUIRED)
option(ICE_VULKAN_VALIDATION "Require Khronos validation and retain bounded error diagnostics" ON)
get_filename_component(ICE_VK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(ICEVulkanRuntime STATIC "${ICE_VK_ROOT}/engine/src/render/vulkan/device.cpp")
add_library(ice::vulkan ALIAS ICEVulkanRuntime)
target_include_directories(ICEVulkanRuntime PUBLIC "${ICE_VK_ROOT}/engine/include")
target_link_libraries(ICEVulkanRuntime PUBLIC ice::expected ice::shader_sources ice::window PRIVATE Vulkan::Vulkan)
if(ICE_VULKAN_VALIDATION)
    target_compile_definitions(ICEVulkanRuntime PRIVATE ICE_VULKAN_VALIDATION=1)
endif()
set_target_properties(ICEVulkanRuntime PROPERTIES POSITION_INDEPENDENT_CODE ON)
ice_strict_target(ICEVulkanRuntime)
